{
  "inputs": [
      {
        "type": "promptString",
        "id": "github_token",
        "description": "GitHub Personal Access Token",
        "password": true
      }
    ],
  "mcpServers": {
    "weather": {
          "command": "/Users/chloechen/.local/bin/uv",
          "args": [
              "--directory",
              "/Users/chloechen/Desktop/mcp-experiment",
              "run",
              "weather.py"
          ]
    },
    "basic_tool": {
      "url": "http://0.0.0.0:8000/sse",
      "disable": false,
      "transportType": "sse"
    },
    "github": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
        }
      }
  }
}